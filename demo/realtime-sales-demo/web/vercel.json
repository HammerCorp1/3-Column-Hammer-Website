{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/dealers", "destination": "/", "permanent": true },
    { "source": "/trial", "destination": "/get-started", "permanent": true },
    { "source": "/facebook", "destination": "/", "permanent": true },
    { "source": "/ads", "destination": "/", "permanent": true },
    { "source": "/guides/dealercenter", "destination": "/guides/dealercenter-compatible-ai", "permanent": true },
    { "source": "/guides/dealercenter/", "destination": "/guides/dealercenter-compatible-ai", "permanent": true },
    { "source": "/guides/dealercenter-ai", "destination": "/guides/dealercenter-compatible-ai", "permanent": true },
    { "source": "/guides/dealercenter-ai/", "destination": "/guides/dealercenter-compatible-ai", "permanent": true },
    { "source": "/guides/dealercenter-compatable-ai", "destination": "/guides/dealercenter-compatible-ai", "permanent": true },
    { "source": "/guides/dealercenter-compatable-ai/", "destination": "/guides/dealercenter-compatible-ai", "permanent": true },
    { "source": "/guides/best-ai-for-dealercenter", "destination": "/guides/dealercenter-compatible-ai", "permanent": true },
    { "source": "/guides/best-ai-for-dealercenter/", "destination": "/guides/dealercenter-compatible-ai", "permanent": true },
    { "source": "/10dlc", "destination": "/sms-terms", "permanent": true },
    { "source": "/requestcancel", "destination": "/support", "permanent": true },
    { "source": "/culture", "destination": "/about", "permanent": true },
    { "source": "/tos", "destination": "/terms", "permanent": true },
    { "source": "/aboutus", "destination": "/about", "permanent": true },
    { "source": "/about-us", "destination": "/about", "permanent": true },
    { "source": "/contact", "destination": "/support", "permanent": true },
    { "source": "/legal/credit-app-privacy-policy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/pricing", "destination": "/guides/pricing", "permanent": true },
    { "source": "/demo", "destination": "/get-started", "permanent": true },
    { "source": "/integrations", "destination": "/guides", "permanent": true },
    { "source": "/blog", "destination": "/guides", "permanent": true },
    { "source": "/case-studies", "destination": "/reviews", "permanent": true }
  ],
  "rewrites": [
    { "source": "/help", "destination": "/help/index.html" },
    { "source": "/help/", "destination": "/help/index.html" },
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/guides/", "destination": "/guides/index.html" },
    {
      "source": "/(reviews|faq|terms|privacy|support|about)",
      "destination": "/$1/index.html"
    },
    { "source": "/(reviews|faq|terms|privacy|support|about)/", "destination": "/$1/index.html" },
    { "source": "/(privacy-policy|sms-terms)", "destination": "/$1/index.html" },
    { "source": "/(privacy-policy|sms-terms)/", "destination": "/$1/index.html" },
    { "source": "/get-started", "destination": "/index.html" }
  ]
}
